# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret. Never expose this value in browser code or GitHub.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# One-time Owner setup code. Use 24+ random characters.
OWNER_SETUP_CODE=replace-with-a-long-random-setup-code
